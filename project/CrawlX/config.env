# ============================================================
# CrawlX — Global Configuration & API Keys
# Edit this file BEFORE running CrawlX.py
# ============================================================

# --- Performance ---
CRAWLX_THREAD_WORKERS=25
CRAWLX_TIMEOUT=10
CRAWLX_MAX_RETRIES=3
CRAWLX_DELAY_MIN=0.3
CRAWLX_DELAY_MAX=1.2

# --- Stealth ---
CRAWLX_USER_AGENT_MODE=rotate
CRAWLX_TLS_IMPERSONATE=chrome124

# --- Scan Modes ---
CRAWLX_SUBDOMAIN_MODE=small
CRAWLX_DIRBUST_WORDLIST=dirs_common.txt
CRAWLX_SCAN_SQLI=true
CRAWLX_SCAN_XSS=true
CRAWLX_DNS_RESOLVER=1.1.1.1

# --- API Keys (leave empty to auto-skip module) ---
